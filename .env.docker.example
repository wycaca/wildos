# Deployment profile, use unity or isaac for simulation
WILDOS_TOPIC_PROFILE=robot

# Main launch switches
DO_OBJECT_SEARCH=true
USE_SIM_TIME=false
LAUNCH_PAPER_RVIZ=false
WILDOS_LOG_LEVEL=INFO

# Optional image names and base image overrides
WILDOS_X86_IMAGE_TAG=x86_64
WILDOS_ORIN_IMAGE_TAG=orin-jp62
WILDOS_X86_BASE_IMAGE=nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04
WILDOS_ORIN_BASE_IMAGE=nvcr.io/nvidia/pytorch:25.04-py3-igpu
