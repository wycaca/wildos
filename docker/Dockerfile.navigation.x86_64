ARG BASE_IMAGE=ros:humble-ros-base-jammy
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=humble

COPY nebula2-wildos/docker/configure_apt_mirrors.sh /tmp/configure_apt_mirrors.sh
RUN chmod +x /tmp/configure_apt_mirrors.sh \
    && /tmp/configure_apt_mirrors.sh auto \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get install -y --no-install-recommends \
      procps \
      python3-colcon-common-extensions \
      python3-numpy \
      python3-opencv \
      python3-scipy \
      ros-humble-rmw-fastrtps-cpp \
      ros-humble-ros2launch \
      ros-humble-sensor-msgs-py \
      ros-humble-tf2-geometry-msgs \
      ros-humble-tf2-ros \
    && /tmp/configure_apt_mirrors.sh https \
    && rm /tmp/configure_apt_mirrors.sh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/wildos_navigation_ws/src
COPY nebula2-wildos/wildos_navigation \
  /opt/wildos_navigation_ws/src/wildos_navigation

RUN source /opt/ros/humble/setup.bash \
    && cd /opt/wildos_navigation_ws \
    && colcon build \
      --merge-install \
      --event-handlers console_direct+ \
      --packages-select wildos_navigation \
      --cmake-args -DBUILD_TESTING=OFF \
    && rm -rf build log

COPY nebula2-wildos/docker/entrypoint.navigation.x86_64.sh \
  /usr/local/bin/wildos-navigation-entrypoint
COPY nebula2-wildos/docker/healthcheck.navigation.x86_64.sh \
  /usr/local/bin/wildos-navigation-healthcheck
RUN chmod +x \
  /usr/local/bin/wildos-navigation-entrypoint \
  /usr/local/bin/wildos-navigation-healthcheck

WORKDIR /opt/wildos_navigation_ws
ENTRYPOINT ["/usr/local/bin/wildos-navigation-entrypoint"]
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
  CMD ["/usr/local/bin/wildos-navigation-healthcheck"]
