ARG BASE_IMAGE=ros:humble-ros-base-jammy
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    LD_LIBRARY_PATH=/usr/local/lib \
    ROS_DISTRO=humble

COPY nebula2-wildos/docker/configure_apt_mirrors.sh /tmp/configure_apt_mirrors.sh
RUN chmod +x /tmp/configure_apt_mirrors.sh \
    && /tmp/configure_apt_mirrors.sh auto \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      git \
      libapr1-dev \
      libboost-chrono-dev \
      libboost-system-dev \
      libboost-thread-dev \
      libeigen3-dev \
      libomp-dev \
      libpcl-dev \
      python3-colcon-common-extensions \
      python3-pip \
      python3-vcstool \
      ros-humble-ament-cmake-auto \
      ros-humble-pcl-conversions \
      ros-humble-pcl-ros \
      ros-humble-rclcpp-components \
      ros-humble-rmw-cyclonedds-cpp \
      ros-humble-rmw-fastrtps-cpp \
      ros-humble-rosidl-default-generators \
      ros-humble-sensor-msgs-py \
      ros-humble-tf2-eigen \
      ros-humble-tf2-geometry-msgs \
      ros-humble-tf2-ros \
    && /tmp/configure_apt_mirrors.sh https \
    && rm /tmp/configure_apt_mirrors.sh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/wildos_localization_ws/src
COPY nebula2-wildos/dependencies/lidar_dlio.repos \
  /tmp/lidar_dlio.repos
RUN vcs import /opt/wildos_localization_ws/src < /tmp/lidar_dlio.repos \
    && rm /tmp/lidar_dlio.repos

COPY nebula2-wildos/graph_construction \
  /opt/wildos_localization_ws/src/graph_construction

COPY nebula2-wildos/docker/build_lidar_dlio.sh \
  /tmp/build_lidar_dlio.sh
RUN chmod +x /tmp/build_lidar_dlio.sh \
    && /tmp/build_lidar_dlio.sh \
    && rm /tmp/build_lidar_dlio.sh \
    && rm -rf /opt/wildos_localization_ws/src/Livox-SDK2

COPY nebula2-wildos/docker/entrypoint.localization.sh \
  /usr/local/bin/wildos-localization-entrypoint
COPY nebula2-wildos/docker/healthcheck.localization.sh \
  /usr/local/bin/wildos-localization-healthcheck
COPY nebula2-wildos/docker/entrypoint.lidar.mid360.sh \
  /usr/local/bin/wildos-mid360-entrypoint
COPY nebula2-wildos/docker/healthcheck.lidar.mid360.sh \
  /usr/local/bin/wildos-mid360-healthcheck
RUN chmod +x \
  /usr/local/bin/wildos-localization-entrypoint \
  /usr/local/bin/wildos-localization-healthcheck \
  /usr/local/bin/wildos-mid360-entrypoint \
  /usr/local/bin/wildos-mid360-healthcheck

WORKDIR /opt/wildos_localization_ws
ENTRYPOINT ["/usr/local/bin/wildos-localization-entrypoint"]
HEALTHCHECK --interval=10s --timeout=12s --start-period=30s --retries=3 \
  CMD ["/usr/local/bin/wildos-localization-healthcheck"]
