ARG BASE_IMAGE=ros:humble-ros-base-jammy
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=humble

COPY nebula2-wildos/docker/configure_apt_mirrors.sh /tmp/configure_apt_mirrors.sh
RUN chmod +x /tmp/configure_apt_mirrors.sh \
    && /tmp/configure_apt_mirrors.sh auto \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      procps \
      ros-humble-compressed-image-transport \
      ros-humble-image-transport \
      ros-humble-realsense2-camera \
      ros-humble-rmw-fastrtps-cpp \
      ros-humble-tf2-ros \
      usbutils \
    && /tmp/configure_apt_mirrors.sh https \
    && rm /tmp/configure_apt_mirrors.sh \
    && rm -rf /var/lib/apt/lists/*

COPY nebula2-wildos/docker/entrypoint.camera.orin.sh \
  /usr/local/bin/wildos-camera-entrypoint
COPY nebula2-wildos/docker/healthcheck.camera.orin.sh \
  /usr/local/bin/wildos-camera-healthcheck
COPY nebula2-wildos/docker/healthcheck.camera.orin.py \
  /usr/local/lib/wildos-camera-healthcheck.py
RUN chmod +x \
  /usr/local/bin/wildos-camera-entrypoint \
  /usr/local/bin/wildos-camera-healthcheck

ENTRYPOINT ["/usr/local/bin/wildos-camera-entrypoint"]
HEALTHCHECK --interval=10s --timeout=8s --start-period=30s --retries=3 \
  CMD ["/usr/local/bin/wildos-camera-healthcheck"]
