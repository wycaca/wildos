ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:24.10-py3-igpu
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG GRAAF_COMMIT=2a4715ff46a25048e06078ea20afc325d59f987a
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=humble \
    WILDOS_IMAGE_ARCH=aarch64 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

COPY nebula2-wildos/docker/configure_apt_mirrors.sh /tmp/configure_apt_mirrors.sh
COPY nebula2-wildos/docker/install_ros_humble.sh /tmp/install_ros_humble.sh
RUN chmod +x /tmp/configure_apt_mirrors.sh /tmp/install_ros_humble.sh \
    && /tmp/install_ros_humble.sh \
    && rm /tmp/configure_apt_mirrors.sh /tmp/install_ros_humble.sh

COPY nebula2-wildos/docker/requirements-runtime.txt /tmp/requirements-runtime.txt
RUN /usr/bin/python3 -m pip install --no-cache-dir --upgrade pip \
    && sed -i '/^transforms3d/d' /tmp/requirements-runtime.txt \
    && /usr/bin/python3 -m pip install --no-cache-dir -r /tmp/requirements-runtime.txt \
    && /usr/bin/python3 -m pip install --no-cache-dir --ignore-installed --no-deps transforms3d==0.4.2 \
    && /usr/bin/python3 -m pip install --no-cache-dir pybase64==1.4.3 transformations==2025.1.1 \
    && /usr/bin/python3 -m pip install --no-cache-dir --no-deps ros2-numpy==0.0.5 \
    && rm /tmp/requirements-runtime.txt
RUN /usr/bin/python3 -m pip install --no-cache-dir cupy-cuda12x==13.6.0

# Keep the runtime environment outside volatile application source layers
RUN /usr/bin/python3 -m pip install --no-cache-dir uv \
    && mkdir -p /opt/wildos_ws/src/nebula2-wildos \
    && uv venv --system-site-packages /opt/wildos_ws/src/nebula2-wildos/.venv

WORKDIR /opt/wildos_ws/src
COPY elevation_mapping_cupy /opt/wildos_ws/src/elevation_mapping_cupy
COPY graaf_vendor /opt/wildos_ws/src/graaf_vendor
COPY nebula2-wildos/graphnav_msgs /opt/wildos_ws/src/nebula2-wildos/graphnav_msgs
COPY nebula2-wildos/object_search_msgs /opt/wildos_ws/src/nebula2-wildos/object_search_msgs
COPY nebula2-wildos/gps_visualization /opt/wildos_ws/src/nebula2-wildos/gps_visualization
COPY nebula2-wildos/triangulation3d /opt/wildos_ws/src/nebula2-wildos/triangulation3d
COPY nebula2-wildos/docker/build_workspace.sh /tmp/build_workspace.sh

RUN chmod +x /tmp/build_workspace.sh \
    && /tmp/build_workspace.sh "${GRAAF_COMMIT}" dependencies

COPY nebula2-wildos/nvidia_radio /opt/wildos_ws/src/nebula2-wildos/nvidia_radio
COPY nebula2-wildos/explorfm /opt/wildos_ws/src/nebula2-wildos/explorfm
RUN /usr/bin/python3 -m pip install --no-cache-dir --no-deps -e /opt/wildos_ws/src/nebula2-wildos/nvidia_radio \
    && /usr/bin/python3 -m pip install --no-cache-dir --no-deps -e /opt/wildos_ws/src/nebula2-wildos/explorfm

COPY nebula2-wildos /opt/wildos_ws/src/nebula2-wildos
RUN mkdir -p /opt/wildos_ws/src/nebula2-wildos/ckpts \
    && ln -sfn frontier_ckpt_new.ckpt /opt/wildos_ws/src/nebula2-wildos/ckpts/frontier_head.ckpt \
    && ln -sfn traversability_ckpt.ckpt /opt/wildos_ws/src/nebula2-wildos/ckpts/trav_head.ckpt \
    && chmod +x \
      /opt/wildos_ws/src/nebula2-wildos/docker/build_workspace.sh \
      /opt/wildos_ws/src/nebula2-wildos/docker/entrypoint.orin.sh \
      /opt/wildos_ws/src/nebula2-wildos/docker/healthcheck.sh \
      /opt/wildos_ws/src/nebula2-wildos/scripts/start_wildos_elevation.sh \
    && /tmp/build_workspace.sh "${GRAAF_COMMIT}" application \
    && /usr/bin/python3 -c "import cupy, torch, torchvision; print(torch.__version__, torch.version.cuda, cupy.__version__)"

COPY nebula2-wildos/docker/ros_environment.sh /etc/profile.d/wildos_ros.sh
RUN chmod 0644 /etc/profile.d/wildos_ros.sh \
    && printf '\nsource /etc/profile.d/wildos_ros.sh\n' >> /root/.bashrc

ENV BASH_ENV=/etc/profile.d/wildos_ros.sh

WORKDIR /opt/wildos_ws
ENTRYPOINT ["/opt/wildos_ws/src/nebula2-wildos/docker/entrypoint.orin.sh"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
  CMD ["/opt/wildos_ws/src/nebula2-wildos/docker/healthcheck.sh"]
