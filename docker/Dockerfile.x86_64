ARG BASE_IMAGE=ros:humble-ros-base-jammy
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    ROS_DISTRO=humble \
    WILDOS_IMAGE_ROLE=localization \
    WILDOS_IMAGE_ARCH=x86_64

COPY nebula2-wildos/docker/configure_apt_mirrors.sh /tmp/configure_apt_mirrors.sh
RUN chmod +x /tmp/configure_apt_mirrors.sh \
    && /tmp/configure_apt_mirrors.sh auto \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      git \
      libeigen3-dev \
      libomp-dev \
      libpcl-dev \
      python3-colcon-common-extensions \
      python3-pip \
      python3-vcstool \
      ros-humble-pcl-conversions \
      ros-humble-pcl-ros \
      ros-humble-rmw-cyclonedds-cpp \
      ros-humble-rosidl-default-generators \
      ros-humble-sensor-msgs-py \
      ros-humble-tf2-eigen \
      ros-humble-tf2-geometry-msgs \
      ros-humble-tf2-ros \
    && /tmp/configure_apt_mirrors.sh https \
    && rm /tmp/configure_apt_mirrors.sh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/wildos_localization_ws/src
COPY nebula2-wildos/dependencies/dlio.repos /tmp/dlio.repos
RUN vcs import /opt/wildos_localization_ws/src < /tmp/dlio.repos \
    && rm /tmp/dlio.repos

COPY nebula2-wildos/graph_construction \
  /opt/wildos_localization_ws/src/graph_construction

WORKDIR /opt/wildos_localization_ws
RUN source /opt/ros/humble/setup.bash \
    && colcon build \
      --merge-install \
      --event-handlers console_direct+ \
      --packages-select \
        direct_lidar_inertial_odometry \
        graph_construction \
      --cmake-args -DBUILD_TESTING=OFF \
    && rm -rf log

COPY nebula2-wildos/docker/entrypoint.localization.sh \
  /usr/local/bin/wildos-localization-entrypoint
COPY nebula2-wildos/docker/healthcheck.localization.sh \
  /usr/local/bin/wildos-localization-healthcheck
RUN chmod +x \
  /usr/local/bin/wildos-localization-entrypoint \
  /usr/local/bin/wildos-localization-healthcheck

WORKDIR /opt/wildos_localization_ws
ENTRYPOINT ["/usr/local/bin/wildos-localization-entrypoint"]
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD ["/usr/local/bin/wildos-localization-healthcheck"]
