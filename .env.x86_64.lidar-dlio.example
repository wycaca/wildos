# x86 雷达和 D-LIO 部署配置
ROS_DOMAIN_ID=2
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# 原始传感器输入
POINTCLOUD_INPUT_TOPIC=/livox/lidar
IMU_INPUT_TOPIC=/livox/imu
LIDAR_FRAME=lidar_link
IMU_FRAME=imu_link
BASE_FRAME=base_link
GLOBAL_FRAME=odom

# Livox MID-360 驱动
MID360_CONFIG_FILE=/absolute/path/to/MID360_config.json
LIVOX_PUBLISH_FREQ=10.0

# Orin 使用的标准输出
POINTCLOUD_OUTPUT_TOPIC=/cloud_registered
ODOM_OUTPUT_TOPIC=/odom

# 挂载到定位容器的宿主机路径
DLIO_CONFIG_FILE=/absolute/path/to/robot_dlio.yaml

# 可选镜像覆盖配置
WILDOS_X86_IMAGE_TAG=x86_64
WILDOS_X86_BASE_IMAGE=ros:humble-ros-base-jammy
