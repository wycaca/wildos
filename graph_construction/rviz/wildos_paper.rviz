Panels:
  - Class: rviz_common/Displays
    Help Height: 90
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /导航图1
        - /Image1
      Splitter Ratio: 0.550000011920929
    Tree Height: 665
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: 导航图
      Namespaces:
        edges: true
        free_nodes: true
        frontier_nodes: true
        frontier_points: true
        memory_free_nodes: true
        robot_odom_position: true
        robot_position: true
        trajectory: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /spot1/graph_construction_viz
      Value: true
    - Alpha: 0.6499999761581421
      Autocompute Intensity Bounds: false
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: false
      Axis: Z
      Channel Name: z
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 1
      Min Color: 255; 255; 255
      Min Intensity: 0
      Name: 目标粒子
