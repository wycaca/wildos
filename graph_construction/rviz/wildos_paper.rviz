    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Head Diameter: 0.25
      Head Length: 0.18000000715255737
      Length: 0.20000000298023224
      Line Style: Lines
