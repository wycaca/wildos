      Selectable: false
      Size (Pixels): 2
      Size (m): 0.019999999552965164
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 2
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /spot1/object_target_particles
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: 目标定位
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /spot1/object_target_estimate_viz
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
