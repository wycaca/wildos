# Orin WildOS and camera deployment configuration
ROS_DOMAIN_ID=2
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# WildOS main chain
DO_OBJECT_SEARCH=true
WILDOS_LOG_LEVEL=INFO
WILDOS_VISUAL_CONFIG=wildos_nav_conf.yaml

# Canonical localization input from the x86 host
GLOBAL_FRAME=odom
BASE_FRAME=base_link
POINTCLOUD_INPUT_TOPIC=/cloud_registered
ODOM_INPUT_TOPIC=/odom
LIDAR_FRAME=lidar_link

# Three camera input produced by the camera service
CAMERA_IMG_TOPIC=/spot1/realsense/{}/color/image_raw/compressed
CAMERA_INFO_TOPIC=/spot1/realsense/{}/color/camera_info
CAMERA_NAMESPACE=spot1/realsense
CAMERA_COLOR_WIDTH=640
CAMERA_COLOR_HEIGHT=480
CAMERA_COLOR_FPS=15

# Bind each logical direction to one physical device
FRONT_CAMERA_SERIAL=replace_with_front_serial
LEFT_CAMERA_SERIAL=replace_with_left_serial
RIGHT_CAMERA_SERIAL=replace_with_right_serial

# Stable USB path fragments, filled automatically by the deployment script
FRONT_CAMERA_USB_PATH=
LEFT_CAMERA_USB_PATH=
RIGHT_CAMERA_USB_PATH=

# Calibrated x y z qx qy qz qw, leave empty until calibration is complete
FRONT_CAMERA_TRANSFORM=
LEFT_CAMERA_TRANSFORM=
RIGHT_CAMERA_TRANSFORM=

# Model path and image settings
WILDOS_CKPT_DIR=/absolute/path/to/nebula2-wildos/ckpts
WILDOS_ORIN_IMAGE_TAG=orin-jp62
WILDOS_ORIN_BASE_IMAGE=nvcr.io/nvidia/pytorch:24.10-py3-igpu
WILDOS_CAMERA_IMAGE_TAG=orin-humble
WILDOS_CAMERA_BASE_IMAGE=ros:humble-ros-base-jammy
